generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus { VERIFIED CONFLICTING UNVERIFIED }
enum ContentStatus { DRAFT PENDING APPROVED REJECTED }

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  devices   Device[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeviceCategory {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  devices Device[]
}

model Device {
  id                 String             @id @default(cuid())
  brandId            String
  categoryId         String
  slug               String             @unique
  modelName          String
  modelNumber        String?
  announcementDate   DateTime?
  releaseDate        DateTime?
  availabilityStatus String?
  startingPrice      Decimal?           @db.Decimal(12, 2)
  currency           String?
  officialProductUrl String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rawProviderPayload Json?
  lastUpdatedAt      DateTime           @updatedAt
  brand              Brand              @relation(fields: [brandId], references: [id])
  category           DeviceCategory     @relation(fields: [categoryId], references: [id])
  variants           DeviceVariant[]
  specifications     Specification[]
  images              ProductImage[]
  priceOffers         PriceOffer[]
  professionalReviews ProfessionalReview[]
  userReviews         UserReview[]
  benchmarks          Benchmark[]
  verificationRecords VerificationRecord[]
  aiContent           AIContent[]
  editorialContent    EditorialContent[]
  comparisonItems     ComparisonItem[]
  @@index([brandId, modelName])
  @@index([categoryId, releaseDate])
}

model DeviceVariant {
  id          String  @id @default(cuid())
  deviceId    String
  region      String?
  color       String?
  ramGb       Int?
  storageGb   Int?
  modelNumber String?
  device      Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@unique([deviceId, region, ramGb, storageGb, modelNumber])
}

model SpecificationGroup {
  id             String          @id @default(cuid())
  name           String
  sortOrder      Int             @default(0)
  specifications Specification[]
}

model Specification {
  id                 String             @id @default(cuid())
  deviceId           String
  groupId            String
  key                String
  label              String
  valueText          String?
  valueNumber        Decimal?           @db.Decimal(18, 4)
  unit               String?
  region             String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  sourceId           String
  lastVerifiedAt     DateTime?
  device             Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  group              SpecificationGroup @relation(fields: [groupId], references: [id])
  source             DataSource         @relation(fields: [sourceId], references: [id])
  @@unique([deviceId, key, region])
}

model ProductImage {
  id             String   @id @default(cuid())
  deviceId       String
  sourceId       String
  url            String
  sourceUrl      String
  license        String?
  color          String?
  sortOrder      Int      @default(0)
  matchConfidence Float?
  lastVerifiedAt DateTime?
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source         DataSource @relation(fields: [sourceId], references: [id])
}

model Retailer {
  id       String       @id @default(cuid())
  name     String
  url      String
  offers   PriceOffer[]
}

model PriceOffer {
  id          String   @id @default(cuid())
  deviceId    String
  retailerId  String
  price       Decimal  @db.Decimal(12, 2)
  currency    String
  affiliateUrl String?
  availability String?
  checkedAt   DateTime
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  retailer    Retailer @relation(fields: [retailerId], references: [id])
}

model ProfessionalReview {
  id          String   @id @default(cuid())
  deviceId    String
  sourceId    String
  title       String
  author      String?
  score       Decimal? @db.Decimal(4, 2)
  excerpt     String?
  url         String
  publishedAt DateTime?
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source      DataSource @relation(fields: [sourceId], references: [id])
}

model UserReview {
  id        String        @id @default(cuid())
  deviceId  String
  rating    Int
  title     String
  body      String
  status    ContentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  device    Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Benchmark {
  id            String   @id @default(cuid())
  deviceId      String
  sourceId      String
  name          String
  score         Decimal? @db.Decimal(18, 4)
  methodologyUrl String
  measuredAt    DateTime?
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source        DataSource @relation(fields: [sourceId], references: [id])
}

model Comparison {
  id        String           @id @default(cuid())
  slug      String           @unique
  priorities Json?
  createdAt DateTime         @default(now())
  items     ComparisonItem[]
}

model ComparisonItem {
  comparisonId String
  deviceId     String
  sortOrder    Int
  comparison   Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  device       Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@id([comparisonId, deviceId])
}

model DataSource {
  id                  String               @id @default(cuid())
  provider            String
  url                 String
  license             String?
  retrievedAt         DateTime             @default(now())
  rawPayloadHash      String?
  specifications      Specification[]
  images              ProductImage[]
  professionalReviews ProfessionalReview[]
  benchmarks          Benchmark[]
  verificationRecords VerificationRecord[]
  @@unique([provider, url])
}

model VerificationRecord {
  id         String             @id @default(cuid())
  deviceId   String
  sourceId   String
  fieldPath  String
  status     VerificationStatus
  note       String?
  verifiedBy String?
  verifiedAt DateTime           @default(now())
  device     Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source     DataSource         @relation(fields: [sourceId], references: [id])
}

model AIContent {
  id          String        @id @default(cuid())
  deviceId    String
  type        String
  content     Json
  model       String
  confidence  Float
  sourceIds   Json
  status      ContentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model EditorialContent {
  id          String        @id @default(cuid())
  deviceId    String
  type        String
  title       String
  body        String
  author      String
  methodology String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}
