# Optional separate licensed image provider. MobileAPI photos use DEVICE_API_KEY.
IMAGE_API_URL=
IMAGE_API_KEY=

# Pricing and retailer offers
PRICE_API_URL=
PRICE_API_KEY=

# Professional review provider
REVIEW_API_URL=
REVIEW_API_KEY=

# Benchmark provider
BENCHMARK_API_URL=
BENCHMARK_API_KEY=

# OpenAI-compatible structured-output provider (server only)
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Admin API protection and production URL
ADMIN_API_TOKEN=
